# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=acres99
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acres99

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@localhost:6379

# ─── OpenSearch (optional; suggestions fall back to Postgres) ────────────────
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PROPERTIES=properties

# ─── API server ──────────────────────────────────────────────────────────────
PORT=3002
# Required in production: 32+ random characters (`openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-random-secret-min-32-chars
JWT_EXPIRY=7d
# Comma-separated web origins allowed by CORS in production
ALLOWED_ORIGIN=http://localhost:3001
# Public URL of the web app, used for links in emails
APP_URL=http://localhost:3001

# ─── Email (Resend). Unset = emails are logged, not sent ─────────────────────
RESEND_API_KEY=
EMAIL_FROM="Aangan <no-reply@yourdomain.com>"

# ─── Storage: AWS S3 (LocalStack in dev: http://localhost:4566) ──────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-south-1
AWS_S3_BUCKET=acres99-media
AWS_S3_ENDPOINT=http://localhost:4566
# Public base URL that serves the bucket (CDN in production)
CLOUDFLARE_CDN_URL=

# ─── Web app (Vercel) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com
# NEXT_PUBLIC_DOMAIN=yourdomain.com

# ─── Local demo data (pnpm --filter @99acres/api-server seed:demo) ────────────
# SEED_EMAIL=demo.lister@aangan.test
# SEED_PASSWORD=

NODE_ENV=development
