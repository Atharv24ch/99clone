# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=acres99
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acres99

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@localhost:6379

# ─── OpenSearch ──────────────────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PROPERTIES=properties

# ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# IMPORTANT: In production, set NEXTAUTH_URL to your actual Vercel deployment URL
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-secret-min-32-chars

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret


# ─── AWS S3 (use LocalStack in dev: http://localhost:4566) ───────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-south-1
AWS_S3_BUCKET=acres99-media
AWS_S3_ENDPOINT=http://localhost:4566

# ─── Cloudflare CDN ──────────────────────────────────────────────────────────
CLOUDFLARE_CDN_URL=https://cdn.yourdomain.com

# ─── API Server ──────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:3002
JWT_SECRET=change-me-to-another-random-secret-min-32-chars
JWT_EXPIRY=7d
PORT=3002

# ─── Mapbox ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# ─── Feature flags ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_MAPS=true
NODE_ENV=development

# ─── Production-only (set these on Vercel / Railway) ──────────────────────────
# NEXT_PUBLIC_DOMAIN=yourdomain.com
# NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com
# ALLOWED_ORIGIN=https://your-app.vercel.app,https://yourdomain.com
