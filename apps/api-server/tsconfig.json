{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // These ultra-strict options conflict with Drizzle ORM insert types
    // and OpenSearch aggregation accessors.
    // All other strict options (noImplicitAny, strictNullChecks, etc.) remain active.
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

